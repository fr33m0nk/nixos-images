// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * DTS overlay for Rockchip RK3588 VDPU381 H.264/H.265/VP9 decoder
 * (rkvdec driver via MPP framework)
 *
 * Disables the mainline hantro vpu121 binding and replaces it with
 * full MPP decoder nodes giving the driver access to the complete
 * VDPU381 hardware.
 *
 * Numeric IDs (no C preprocessor needed):
 *   Clock IDs:  ACLK_RKVDEC0=385  HCLK_RKVDEC0=384  ACLK_VDPU_ROOT=429
 *               HCLK_VDPU_ROOT=431  CLK_RKVDEC0_CORE=388  ACLK_RKVDEC_CCU=383
 *   Reset IDs:  SRST_A_RKVDEC0=323  SRST_H_RKVDEC0=322
 *   Power:      RK3588_PD_RKVDEC0=14
 *   GIC_SPI=0   IRQ_TYPE_LEVEL_HIGH=4
 *
 * Based on rcawston's rkvenc encoder overlay pattern.
 */

/dts-v1/;
/plugin/;

/* Disable mainline hantro vpu121 to free the MMIO region */
&vpu121 {
	status = "disabled";
};

&vpu121_mmu {
	status = "disabled";
};

&{/} {
	#address-cells = <2>;
	#size-cells = <2>;

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		rkvdec0_rcb_iova: rkvdec0-rcb-iova {
			iommu-addresses = <&rkvdec0 0x0 0xffb00000 0x0 0x100000>;
		};
	};

	/* Aliases for core ID assignment (of_alias_get_id) */
	aliases {
		rkvdec0 = &rkvdec0;
	};

	/* CCU — multi-format coordination unit */
	rkvdec_ccu: rkvdec-ccu {
		compatible = "rockchip,rkv-decoder-v2-ccu";
	};

	/* Decoder core — VDPU381 @ 0xfdb50000 */
	rkvdec0: rkvdec-core@fdb50000 {
		compatible = "rockchip,rkv-decoder-v2-core";
		reg = <0x0 0xfdb50000 0x0 0x800>;
		interrupts = <0x0 119 0x4 0x0>;
		interrupt-names = "vdpu";
		rockchip,core-id = <0>;
		memory-region = <&rkvdec0_rcb_iova>;
		clocks = <&cru 385>, <&cru 384>, <&cru 429>,
			 <&cru 431>, <&cru 388>, <&cru 383>;
		clock-names = "aclk_vcodec", "hclk_vcodec", "aclk_vdpu_root",
			      "hclk_vdpu_root", "clk_core", "aclk_ccu";
		rockchip,normal-rates = <400000000>, <200000000>, <400000000>,
					<200000000>, <400000000>, <400000000>;
		assigned-clocks = <&cru 385>, <&cru 388>;
		assigned-clock-rates = <400000000>, <400000000>;
		resets = <&cru 323>, <&cru 322>;
		reset-names = "video_a", "video_h";
		rockchip,sram = <&system_sram2>;
		rockchip,rcb-iova = <0xffb00000 0x100000>;
		iommus = <&rkvdec0_mmu>;
		rockchip,srv = <&mpp_srv>;
		rockchip,ccu = <&rkvdec_ccu>;
		rockchip,taskqueue-node = <0>;
		rockchip,resetgroup-node = <0>;
		rockchip,task-capacity = <4>;
		power-domains = <&power 14>;
	};

	/* IOMMU for decoder core — same reg as vpu121_mmu */
	rkvdec0_mmu: iommu@fdb50800 {
		compatible = "rockchip,rk3588-iommu", "rockchip,rk3568-iommu";
		reg = <0x0 0xfdb50800 0x0 0x40>;
		interrupts = <0x0 118 0x4 0x0>;
		clocks = <&cru 385>, <&cru 384>;
		clock-names = "aclk", "iface";
		rockchip,disable-mmu-reset;
		#iommu-cells = <0>;
		power-domains = <&power 14>;
	};
};
