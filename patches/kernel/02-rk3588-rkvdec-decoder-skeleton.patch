+config VIDEO_ROCKCHIP_RKVDEC2
+	tristate "Rockchip VDPU381 MPP decoder (rkvdec2)"
+	depends on (ARCH_ROCKCHIP || COMPILE_TEST) && VIDEO_ROCKCHIP_RKVENC
+	depends on VIDEO_DEV && IOMMU_API
+	select VIDEOBUF2_DMA_CONTIG
+	help
+	  Stateful MPP decoder for the VDPU381 on RK3588.
+	  H.264 / HEVC / VP9 via /dev/mpp_service.
+	  Shares the MPP framework singleton with rkvenc.
diff -ruN a/drivers/media/platform/rockchip/rkvdec2/Makefile b/drivers/media/platform/rockchip/rkvdec2/Makefile
--- a/drivers/media/platform/rockchip/rkvdec2/Makefile	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvdec2/Makefile	2026-07-18 00:00:00.000000000 +0000
@@ -0,0 +1,3 @@
+# SPDX-License-Identifier: GPL-2.0
+obj-$(CONFIG_VIDEO_ROCKCHIP_RKVDEC2) += rkvdec2.o
+rkvdec2-objs := rkvdec2_drv.o rkvdec2_service.o rkvdec2_iommu.o rkvdec2_task.o rkvdec2_hw.o
diff -ruN a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_drv.c b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_drv.c
--- a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_drv.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_drv.c	2026-07-18 00:00:00.000000000 +0000
@@ -0,0 +1,248 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * VDPU381 MPP decoder — platform device probe/remove.
+ * Based on rcawston's rkvenc encoder, adapted for decode.
+ * Copyright (C) 2026 fr33m0nk
+ */
+#include <linux/clk.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/reset.h>
+#include "rkvdec2_hw.h"
+#include "rkvdec2_service.h"
+#include "rkvdec2_task.h"
+#include "../rkvenc/rkvenc_service.h"
+
+struct rkvdec2_dev {
+	struct device *dev;
+	void __iomem *regs;
+	struct clk *axi, *ahb, *cabac, *core, *hevc_cabac;
+	struct reset_control *rst_axi, *rst_ahb, *rst_cabac, *rst_core, *rst_hevc_cabac;
+	struct rkvdec2_service *service;
+	struct rkvdec2_task_mgr *task_mgr;
+	int irq;
+	u32 core_id;
+};
+
+static irqreturn_t rkvdec2_irq(int irq, void *data)
+{
+	struct rkvdec2_dev *rdev = data;
+	u32 st;
+
+	rkvdec2_hw_irq_handler(rdev->regs, &st);
+	if (!st)
+		return IRQ_NONE;
+	return IRQ_WAKE_THREAD;
+}
+
+static irqreturn_t rkvdec2_irq_thread(int irq, void *data)
+{
+	rkvdec2_task_irq_thread(((struct rkvdec2_dev *)data)->task_mgr);
+	return IRQ_HANDLED;
+}
+
+static int rkvdec2_clk_enable(struct rkvdec2_dev *rdev)
+{
+	int ret;
+	ret  = clk_prepare_enable(rdev->axi);      if (ret) return ret;
+	ret  = clk_prepare_enable(rdev->ahb);      if (ret) goto e_ahb;
+	ret  = clk_prepare_enable(rdev->cabac);    if (ret) goto e_cabac;
+	ret  = clk_prepare_enable(rdev->core);     if (ret) goto e_core;
+	ret  = clk_prepare_enable(rdev->hevc_cabac); if (ret) goto e_hcabac;
+	return 0;
+e_hcabac: clk_disable_unprepare(rdev->core);
+e_core:   clk_disable_unprepare(rdev->cabac);
+e_cabac:  clk_disable_unprepare(rdev->ahb);
+e_ahb:    clk_disable_unprepare(rdev->axi);
+	return ret;
+}
+
+static void rkvdec2_clk_disable(struct rkvdec2_dev *rdev)
+{
+	clk_disable_unprepare(rdev->hevc_cabac);
+	clk_disable_unprepare(rdev->core);
+	clk_disable_unprepare(rdev->cabac);
+	clk_disable_unprepare(rdev->ahb);
+	clk_disable_unprepare(rdev->axi);
+}
+
+/* Callback thunks for the mpp_service dispatch */
+static int rkvdec2_submit(void *priv, void *task)
+{
+	struct rkvdec2_dev *rdev = platform_get_drvdata(priv);
+	if (!rdev || !rdev->task_mgr)
+		return -ENODEV;
+	/* Layer 2b: dispatch to HAL — stub returns success */
+	return 0;
+}
+
+static void rkvdec2_irq_cb(void *priv)
+{
+	struct rkvdec2_dev *rdev = platform_get_drvdata(priv);
+	if (!rdev || !rdev->task_mgr)
+		return;
+	rkvdec2_task_irq_thread(rdev->task_mgr);
+}
+
+static int rkvdec2_get_clocks(struct rkvdec2_dev *rdev, struct device *dev)
+{
+	rdev->axi   = devm_clk_get(dev, "axi");
+	rdev->ahb   = devm_clk_get(dev, "ahb");
+	rdev->cabac = devm_clk_get(dev, "cabac");
+	rdev->core  = devm_clk_get(dev, "core");
+	rdev->hevc_cabac = devm_clk_get(dev, "hevc_cabac");
+	if (IS_ERR(rdev->axi) || IS_ERR(rdev->ahb) || IS_ERR(rdev->core) ||
+	    IS_ERR(rdev->cabac) || IS_ERR(rdev->hevc_cabac))
+		return dev_err_probe(dev, -ENODEV, "clock missing\n");
+	return 0;
+}
+
+static int rkvdec2_get_resets(struct rkvdec2_dev *rdev, struct device *dev)
+{
+	rdev->rst_axi   = devm_reset_control_get(dev, "axi");
+	rdev->rst_ahb   = devm_reset_control_get(dev, "ahb");
+	rdev->rst_cabac = devm_reset_control_get(dev, "cabac");
+	rdev->rst_core  = devm_reset_control_get(dev, "core");
+	rdev->rst_hevc_cabac = devm_reset_control_get(dev, "hevc_cabac");
+	if (IS_ERR(rdev->rst_axi) || IS_ERR(rdev->rst_ahb))
+		return dev_err_probe(dev, -ENODEV, "reset missing\n");
+	return 0;
+}
+
+static void rkvdec2_reset_deassert(struct rkvdec2_dev *rdev)
+{
+	reset_control_deassert(rdev->rst_axi);
+	reset_control_deassert(rdev->rst_ahb);
+	if (!IS_ERR(rdev->rst_cabac)) reset_control_deassert(rdev->rst_cabac);
+	if (!IS_ERR(rdev->rst_core))  reset_control_deassert(rdev->rst_core);
+	if (!IS_ERR(rdev->rst_hevc_cabac)) reset_control_deassert(rdev->rst_hevc_cabac);
+}
+
+static void rkvdec2_reset_assert(struct rkvdec2_dev *rdev)
+{
+	if (!IS_ERR(rdev->rst_hevc_cabac)) reset_control_assert(rdev->rst_hevc_cabac);
+	if (!IS_ERR(rdev->rst_core))  reset_control_assert(rdev->rst_core);
+	if (!IS_ERR(rdev->rst_cabac)) reset_control_assert(rdev->rst_cabac);
+	reset_control_assert(rdev->rst_ahb);
+	reset_control_assert(rdev->rst_axi);
+}
+
+static int rkvdec2_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct resource *res;
+	struct rkvdec2_dev *rdev;
+	int ret;
+
+	rdev = devm_kzalloc(dev, sizeof(*rdev), GFP_KERNEL);
+	if (!rdev) return -ENOMEM;
+	rdev->dev = dev;
+	platform_set_drvdata(pdev, rdev);
+	of_property_read_u32(dev->of_node, "rockchip,core-id", &rdev->core_id);
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	rdev->regs = devm_ioremap_resource(dev, res);
+	if (IS_ERR(rdev->regs)) return PTR_ERR(rdev->regs);
+
+	ret = rkvdec2_get_clocks(rdev, dev);
+	if (ret) return ret;
+	ret = rkvdec2_get_resets(rdev, dev);
+	if (ret) return ret;
+
+	rdev->irq = platform_get_irq(pdev, 0);
+	if (rdev->irq < 0) return rdev->irq;
+
+	ret = rkvdec2_clk_enable(rdev);
+	if (ret) return ret;
+	rkvdec2_reset_deassert(rdev);
+
+	rkvdec2_hw_init(rdev->regs);
+
+	rdev->service = rkvdec2_service_create(dev, rdev->core_id, rdev->regs);
+	if (IS_ERR(rdev->service)) {
+		ret = PTR_ERR(rdev->service);
+		goto err_service;
+	}
+
+	/* Register with the shared mpp_service (created by rkvenc.ko).
+	 * If rkvenc hasn't probed yet, EPROBE_DEFER triggers reprobe. */
+	{
+		struct rkvenc_service *mpp = rkvenc_service_get();
+		if (IS_ERR(mpp)) {
+			ret = PTR_ERR(mpp);
+			dev_info(dev, "mpp_service deferred (%d)\n", ret);
+			goto err_mpp;
+		}
+		ret = rkvenc_service_register_decoder(mpp, pdev, rdev->core_id,
+						    rkvdec2_submit, rkvdec2_irq_cb);
+		if (ret) {
+			dev_err(dev, "decoder register failed: %d\n", ret);
+			goto err_mpp;
+		}
+	}
+
+	rdev->task_mgr = rkvdec2_task_create(dev, rdev->service, rdev->regs, rdev->core_id);
+	if (IS_ERR(rdev->task_mgr)) {
+		ret = PTR_ERR(rdev->task_mgr);
+		goto err_task;
+	}
+
+	ret = devm_request_threaded_irq(dev, rdev->irq,
+		rkvdec2_irq, rkvdec2_irq_thread,
+		IRQF_SHARED, dev_name(dev), rdev);
+	if (ret) {
+		dev_err(dev, "irq %d: %d\n", rdev->irq, ret);
+		goto err_irq;
+	}
+
+	pm_runtime_enable(dev);
+	dev_info(dev, "VDPU381 core %u ready\n", rdev->core_id);
+	return 0;
+
+err_irq:   rkvdec2_task_destroy(rdev->task_mgr);
+		/* fall through — register succeeded on this path */
+err_task:
+	{
+		struct rkvenc_service *mpp = rkvenc_service_get();
+		if (!IS_ERR(mpp))
+			rkvenc_service_unregister_decoder(mpp);
+	}
+		/* fall through */
+err_mpp:   rkvdec2_service_destroy(rdev->service);
+err_service:
+	rkvdec2_reset_assert(rdev);
+	rkvdec2_clk_disable(rdev);
+	return ret;
+}
+
+static void rkvdec2_remove(struct platform_device *pdev)
+{
+	struct rkvdec2_dev *rdev = platform_get_drvdata(pdev);
+	pm_runtime_disable(&pdev->dev);
+	{
+		struct rkvenc_service *mpp = rkvenc_service_get();
+		if (!IS_ERR(mpp))
+			rkvenc_service_unregister_decoder(mpp);
+	}
+	rkvdec2_task_destroy(rdev->task_mgr);
+	rkvdec2_service_destroy(rdev->service);
+	rkvdec2_reset_assert(rdev);
+	rkvdec2_clk_disable(rdev);
+}
+
+static const struct of_device_id rkvdec2_match[] = {
+	{ .compatible = "rockchip,rkv-decoder-v2-core" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, rkvdec2_match);
+
+static struct platform_driver rkvdec2_driver = {
+	.probe  = rkvdec2_probe,
+	.remove = rkvdec2_remove,
+	.driver = { .name = "rkvdec2", .of_match_table = of_match_ptr(rkvdec2_match) },
+};
+module_platform_driver(rkvdec2_driver);
+MODULE_DESCRIPTION("Rockchip VDPU381 MPP decoder"); MODULE_LICENSE("GPL");
diff -ruN a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_hw.h b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_hw.h
--- a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_hw.h	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_hw.h	2026-07-18 00:00:00.000000000 +0000
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * VDPU381 decode HAL interface.
+ * Register programming ported incrementally from vendor mpp_rkvdec2.c.
+ * Copyright (C) 2026 fr33m0nk
+ */
+#ifndef _RKVDEC2_HW_H_
+#define _RKVDEC2_HW_H_
+#include <linux/types.h>
+
+enum rkvdec2_codec {
+	RKVDEC2_CODEC_H264 = 0,
+	RKVDEC2_CODEC_HEVC,
+	RKVDEC2_CODEC_VP9,
+	RKVDEC2_CODEC_MAX
+};
+
+struct rkvdec2_frame_desc {
+	u32 width, height, codec, profile, level;
+	dma_addr_t bs_dma;        u32 bs_size;
+	dma_addr_t ref_dma[16];   u32 ref_count;
+	dma_addr_t dst_dma;       u32 dst_stride;
+	dma_addr_t dpb_dma[16];   u32 dpb_count;
+	union {
+		struct { u32 sps_flags, pps_flags, slice_flags, scaling_matrix;
+			 u32 ref_l0, ref_l1; } h264;
+		struct { u32 sps_flags, pps_flags, slice_flags, scaling_list;
+			 u32 ref_l0; } hevc;
+		struct { u32 frame_type, profile, bit_depth, ref_count; } vp9;
+	} codec_params;
+};
+
+int  rkvdec2_hw_run(void __iomem *regs, struct rkvdec2_frame_desc *desc);
+void rkvdec2_hw_irq_handler(void __iomem *regs, u32 *status);
+void rkvdec2_hw_power_on(void __iomem *regs);
+void rkvdec2_hw_power_off(void __iomem *regs);
+int  rkvdec2_hw_init(void __iomem *regs);
+const char *rkvdec2_codec_name(enum rkvdec2_codec codec);
+
+#define RKVDEC2_MAX_WIDTH  7680
+#define RKVDEC2_MAX_HEIGHT 4320
+#endif
diff -ruN a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_hw.c b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_hw.c
--- a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_hw.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_hw.c	2026-07-18 00:00:00.000000000 +0000
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * VDPU381 decode HAL — register-level programming (STUB).
+ * Phase 1: probe init, power mgmt, IRQ handling.
+ * Phase 2: H.264 registers (port from mpp_rkvdec2.c).
+ * Phase 3: HEVC + VP9 registers.
+ * Copyright (C) 2026 fr33m0nk
+ */
+#include <linux/io.h>
+#include <linux/delay.h>
+#include "rkvdec2_hw.h"
+
+/* Vendor VDPU381 register map (from armbian/linux-rockchip rk-6.1-rkr5.1) */
+#define VDPU_REG_RLC_BASE        0x200   /* bitstream buffer config */
+#define VDPU_REG_START_EN        0x28    /* start decode + write index */
+#define VDPU_REG_INT_EN          0x380   /* interrupt enable */
+#define VDPU_REG_STRIDE          0x50    /* Y stride (index 20 × 4) */
+#define VDPU_REG_CACHE0_SIZE     0x51c   /* cache 0 config */
+#define VDPU_REG_CACHE1_SIZE     0x55c
+#define VDPU_REG_CACHE2_SIZE     0x59c
+#define VDPU_REG_CLR_CACHE0      0x510   /* clear cache 0 */
+#define VDPU_REG_CLR_CACHE1      0x550
+#define VDPU_REG_CLR_CACHE2      0x590
+#define VDPU_REG_AXI_CTRL        0x040   /* AXI read outstanding */
+#define VDPU_REG_FORMAT          0x044   /* codec format select */
+
+#define VDPU_CACHE_LINE_64       BIT(4)
+#define VDPU_CACHE_CACHEABLE      BIT(0)
+#define VDPU_CACHE_READ_ALLOC     BIT(1)
+
+/* Basic register offsets (still needed for IRQ/power/reset) */
+#define VDPU_IRQ_STATUS    0x0004
+#define VDPU_IRQ_CLEAR     0x0008
+#define VDPU_IRQ_MASK      0x000C
+#define VDPU_POWER_CTRL    0x0010
+#define VDPU_SOFT_RESET     0x0014
+
+#define VDPU_SOFTRESET_EN       BIT(20)  /* from vendor: RKVDEC_SOFTRESET_EN */
+#define VDPU_START_EN           BIT(0)   /* from vendor: RKVDEC_START_EN */
+
+#define VDPU_IRQ_DEC_DONE   BIT(0)
+#define VDPU_IRQ_DEC_ERROR  BIT(1)
+#define VDPU_IRQ_BUS_ERROR  BIT(2)
+#define VDPU_IRQ_TIMEOUT    BIT(3)
+
+#define R(reg)    readl(regs + (reg))
+#define W(reg,v)  writel(v, regs + (reg))
+
+int rkvdec2_hw_run(void __iomem *regs, struct rkvdec2_frame_desc *desc)
+{
+	/* Phase 2b placeholder: replay userspace register blob, then start.
+	 * The vendor mpp_rkvdec2_run() sequence:
+	 *   1. Write cache config (CACHE*_SIZE_BASE)
+	 *   2. Clear caches (CLR_CACHE*_BASE)
+	 *   3. For each w_req: write task->reg[s..e] to hardware
+	 *   4. Flush IOMMU TLB
+	 *   5. wmb(); write START_EN = reg[reg_en] | START_EN
+	 *
+	 * Currently: synthetic completion via IRQ status.  Userspace MPP
+	 * will send SET_REG_WRITE messages with pre-computed register blobs
+	 * once the task->reg[] capture is wired in the ioctl dispatch. */
+	W(VDPU_IRQ_CLEAR,  VDPU_IRQ_DEC_DONE);
+	W(VDPU_IRQ_STATUS, VDPU_IRQ_DEC_DONE);
+	return 0;
+}
+
+void rkvdec2_hw_irq_handler(void __iomem *regs, u32 *status)
+{
+	u32 st = R(VDPU_IRQ_STATUS);
+	*status = st;
+	if (st & VDPU_IRQ_DEC_DONE)  W(VDPU_IRQ_CLEAR, VDPU_IRQ_DEC_DONE);
+	if (st & VDPU_IRQ_DEC_ERROR) W(VDPU_IRQ_CLEAR, VDPU_IRQ_DEC_ERROR);
+	if (st & VDPU_IRQ_BUS_ERROR) W(VDPU_IRQ_CLEAR, VDPU_IRQ_BUS_ERROR);
+	if (st & VDPU_IRQ_TIMEOUT)   W(VDPU_IRQ_CLEAR, VDPU_IRQ_TIMEOUT);
+}
+
+void rkvdec2_hw_power_on(void __iomem *regs)
+{ W(VDPU_SOFT_RESET, 0); udelay(10); W(VDPU_POWER_CTRL, 1); }
+
+void rkvdec2_hw_power_off(void __iomem *regs)
+{ W(VDPU_POWER_CTRL, 0); }
+
+int rkvdec2_hw_init(void __iomem *regs)
+{
+	u32 ver;
+	W(VDPU_SOFT_RESET, 1); udelay(10);
+	W(VDPU_SOFT_RESET, 0); udelay(10);
+	W(VDPU_IRQ_CLEAR, 0xffffffff);
+	ver = R(0x0000) & 0xffff;
+	pr_info("rkvdec2: VDPU381 core version %04x\n", ver);
+	return 0;
+}
+
+const char *rkvdec2_codec_name(enum rkvdec2_codec c)
+{
+	static const char *n[] = {"H.264","HEVC","VP9"};
+	return (c < RKVDEC2_CODEC_MAX) ? n[c] : "?";
+}
diff -ruN a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_service.h b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_service.h
--- a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_service.h	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_service.h	2026-07-18 00:00:00.000000000 +0000
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * MPP service wrapper — thin shim around the global mpp_srv singleton.
+ * Shared between rkvenc (encoder) and rkvdec2 (decoder).
+ * Copyright (C) 2026 fr33m0nk
+ */
+#ifndef _RKVDEC2_SERVICE_H_
+#define _RKVDEC2_SERVICE_H_
+#include <linux/device.h>
+#include <linux/types.h>
+
+struct rkvdec2_service;
+
+struct rkvdec2_service *rkvdec2_service_create(struct device *dev,
+	u32 core_id, void __iomem *regs);
+void rkvdec2_service_destroy(struct rkvdec2_service *svc);
+
+void rkvdec2_service_signal(struct rkvdec2_service *svc, s32 result);
+void __iomem *rkvdec2_service_regs(struct rkvdec2_service *svc);
+u32 rkvdec2_service_core_id(struct rkvdec2_service *svc);
+
+/* TODO Phase 2: link with rkvenc's mpp_srv singleton via exported symbol */
+
+#endif
diff -ruN a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_service.c b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_service.c
--- a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_service.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_service.c	2026-07-18 00:00:00.000000000 +0000
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MPP service wrapper.
+ * rkvdec2 and rkvenc share /dev/mpp_service through the mpp_srv
+ * singleton.  Until Phase 2 wires the symbol export, the service
+ * operates in standalone mode (probe succeeds, mpp deferred).
+ * Copyright (C) 2026 fr33m0nk
+ */
+#include <linux/slab.h>
+#include <linux/io.h>
+#include <linux/err.h>
+#include "rkvdec2_service.h"
+
+struct rkvdec2_service {
+	struct device *dev;
+	u32 core_id;
+	void __iomem *regs;
+	/* mpp_srv singleton — NULL until Phase 2 symbol export */
+};
+
+struct rkvdec2_service *rkvdec2_service_create(struct device *dev,
+	u32 core_id, void __iomem *regs)
+{
+	struct rkvdec2_service *svc;
+
+	svc = kzalloc(sizeof(*svc), GFP_KERNEL);
+	if (!svc) return ERR_PTR(-ENOMEM);
+	svc->dev = dev;
+	svc->core_id = core_id;
+	svc->regs = regs;
+
+	dev_info(dev, "rkvdec2 service core-%u created (mpp deferred)\n", core_id);
+	return svc;
+}
+
+void rkvdec2_service_destroy(struct rkvdec2_service *svc)
+{
+	/* Phase 2: unregister from mpp_srv */
+	kfree(svc);
+}
+
+void rkvdec2_service_signal(struct rkvdec2_service *svc, s32 result)
+{
+	/* Phase 2: push completion to mpp_srv which wakes userspace */
+}
+
+void __iomem *rkvdec2_service_regs(struct rkvdec2_service *svc)
+{
+	return svc->regs;
+}
+
+u32 rkvdec2_service_core_id(struct rkvdec2_service *svc)
+{
+	return svc->core_id;
+}
