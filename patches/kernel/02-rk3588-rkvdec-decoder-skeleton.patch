@@ -0,0 +1,9 @@
+config VIDEO_ROCKCHIP_RKVDEC2
+	tristate "Rockchip VDPU381 MPP decoder (rkvdec2)"
+	depends on (ARCH_ROCKCHIP || COMPILE_TEST) && VIDEO_ROCKCHIP_RKVENC
+	depends on VIDEO_DEV && IOMMU_API
+	select VIDEOBUF2_DMA_CONTIG
+	help
+	  Stateful MPP decoder for the VDPU381 on RK3588.
+	  H.264 / HEVC / VP9 via /dev/mpp_service.
+	  Shares the MPP framework singleton with rkvenc.
diff -ruN a/drivers/media/platform/rockchip/rkvdec2/Makefile b/drivers/media/platform/rockchip/rkvdec2/Makefile
--- a/drivers/media/platform/rockchip/rkvdec2/Makefile	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvdec2/Makefile	2026-07-18 00:00:00.000000000 +0000
@@ -0,0 +1,3 @@
+# SPDX-License-Identifier: GPL-2.0
+obj-$(CONFIG_VIDEO_ROCKCHIP_RKVDEC2) += rkvdec2.o
+rkvdec2-objs := rkvdec2_drv.o rkvdec2_service.o rkvdec2_iommu.o rkvdec2_task.o rkvdec2_hw.o
diff -ruN a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_drv.c b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_drv.c
--- a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_drv.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_drv.c	2026-07-18 00:00:00.000000000 +0000
@@ -0,0 +1,392 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * VDPU381 MPP decoder — platform device probe/remove.
+ * Based on rcawston's rkvenc encoder, adapted for decode.
+ * Copyright (C) 2026 fr33m0nk
+ */
+#include <linux/clk.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/reset.h>
+#include <linux/dma-mapping.h>
+#include <linux/sizes.h>
+#include <linux/iommu.h>
+#include <linux/mm.h>
+#include "rkvdec2_hw.h"
+#include "rkvdec2_service.h"
+#include "rkvdec2_task.h"
+#include "rkvdec2_iommu.h"
+#include "../rkvenc/rkvenc_service.h"
+
+struct rkvdec2_dev {
+	struct device *dev;
+	void __iomem *regs;
+	struct clk *axi, *ahb, *cabac, *core, *hevc_cabac;
+	struct reset_control *rst_axi, *rst_ahb, *rst_cabac, *rst_core, *rst_hevc_cabac;
+	struct rkvdec2_service *service;
+	struct rkvdec2_task_mgr *task_mgr;
+	int irq;
+	u32 core_id;
+	void *scratch_cpu;         /* fallback page for valid-but-null addrs */
+	dma_addr_t scratch_dma;
+	struct page *zero_page;  /* shared page for IOVA 0-1G mapping */
+};
+
+static irqreturn_t rkvdec2_irq(int irq, void *data)
+{
+	struct rkvdec2_dev *rdev = data;
+	u32 st;
+
+	rkvdec2_hw_irq_handler(rdev->regs, &st);
+	if (!st)
+		return IRQ_NONE;
+	rkvdec2_task_latch_irq(rdev->task_mgr, st);
+	dev_info(rdev->dev, "irq: hw status 0x%08x %s%s%s%s\n", st,
+		(st & BIT(2)) ? "READY " : "",
+		(st & BIT(3)) ? "BUS " : "",
+		(st & BIT(4)) ? "ERROR " : "",
+		(st & BIT(5)) ? "TIMEOUT " : "");
+	if (st & BIT(4))
+		rkvdec2_hw_dump_error(rdev->regs);
+	return IRQ_WAKE_THREAD;
+}
+
+static irqreturn_t rkvdec2_irq_thread(int irq, void *data)
+{
+	rkvdec2_task_irq_thread(((struct rkvdec2_dev *)data)->task_mgr);
+	return IRQ_HANDLED;
+}
+
+static int rkvdec2_clk_enable(struct rkvdec2_dev *rdev)
+{
+	int ret;
+	ret  = clk_prepare_enable(rdev->axi);      if (ret) return ret;
+	ret  = clk_prepare_enable(rdev->ahb);      if (ret) goto e_ahb;
+	ret  = clk_prepare_enable(rdev->cabac);    if (ret) goto e_cabac;
+	ret  = clk_prepare_enable(rdev->core);     if (ret) goto e_core;
+	ret  = clk_prepare_enable(rdev->hevc_cabac); if (ret) goto e_hcabac;
+	return 0;
+e_hcabac: clk_disable_unprepare(rdev->core);
+e_core:   clk_disable_unprepare(rdev->cabac);
+e_cabac:  clk_disable_unprepare(rdev->ahb);
+e_ahb:    clk_disable_unprepare(rdev->axi);
+	return ret;
+}
+
+static void rkvdec2_clk_disable(struct rkvdec2_dev *rdev)
+{
+	clk_disable_unprepare(rdev->hevc_cabac);
+	clk_disable_unprepare(rdev->core);
+	clk_disable_unprepare(rdev->cabac);
+	clk_disable_unprepare(rdev->ahb);
+	clk_disable_unprepare(rdev->axi);
+}
+
+/* Callback thunks for the mpp_service dispatch */
+static int rkvdec2_submit(void *priv, void *msgs_ptr)
+{
+	struct rkvenc_task_msgs *msgs = msgs_ptr;
+	struct rkvdec2_dev *rdev = platform_get_drvdata(priv);
+	struct mpp_request *reqs, *req;
+	struct rkvdec2_task *task;
+	u32 i, cnt;
+	int ret;
+
+	if (!rdev || !rdev->task_mgr)
+		return -ENODEV;
+
+	cnt  = rkvenc_task_msgs_req_cnt(msgs);
+	reqs = rkvenc_task_msgs_reqs(msgs);
+	if (!reqs)
+		return 0;
+
+	/* Allocate a decode task with register array */
+	task = kzalloc(sizeof(*task), GFP_KERNEL);
+	if (!task)
+		return -ENOMEM;
+	task->dev = rdev->dev;
+	task->scratch_iova = rdev->scratch_dma;
+
+	/* Parse ioctl message list — copy SET_REG_WRITE spans
+	 * into task->reg[], record each in w_reqs[] for hw_run. */
+	for (i = 0; i < cnt; i++) {
+		req = &reqs[i];
+		dev_info(rdev->dev, "  msg[%u] cmd=0x%x size=%u off=0x%x\n",
+			 i, req->cmd, req->size, req->offset);
+		if (!req->size)
+			continue;
+		switch (req->cmd) {
+		case MPP_CMD_SET_REG_WRITE: {
+			u32 off = req->offset / 4;
+			u32 words = req->size / 4 + (req->size & 3 ? 1 : 0);
+			if (off >= RKVDEC2_REG_NUM ||
+			    words > RKVDEC2_REG_NUM - off ||
+			    task->w_req_cnt >= RKVDEC2_MAX_WRITE_PART) {
+				ret = -EINVAL;
+				goto err_free;
+			}
+			if (copy_from_user(&task->reg[off], req->data, req->size)) {
+				ret = -EFAULT;
+				goto err_free;
+			}
+			task->w_reqs[task->w_req_cnt].offset = req->offset;
+			task->w_reqs[task->w_req_cnt].size   = req->size;
+			task->w_req_cnt++;
+			dev_info(rdev->dev, "  wr off=0x%x sz=%u\n",
+				 req->offset, req->size);
+			break;
+		}
+		case MPP_CMD_SET_REG_ADDR_OFFSET:
+			/* Capture offset info for later fd→iova translation.
+			 * Format: each elem in data is {index, offset}. */
+			if (req->size <= sizeof(task->off_inf.elem[0]) *
+			    (ARRAY_SIZE(task->off_inf.elem) - task->off_inf.cnt))
+				if (copy_from_user(
+					&task->off_inf.elem[task->off_inf.cnt],
+					req->data, req->size) == 0)
+					task->off_inf.cnt +=
+					  req->size / sizeof(task->off_inf.elem[0]);
+			break;
+		}
+	}
+
+	{
+		u32 k;
+		dev_info(rdev->dev, "captured: reqs=%u writes=%u; nonzero regs:\n",
+			 cnt, task->w_req_cnt);
+		for (k = 0; k < RKVDEC2_REG_NUM; k++)
+			if (task->reg[k])
+				dev_info(rdev->dev, "  reg[%u]=%08x\n",
+					 k, task->reg[k]);
+	}
+
+	/* Resolve fd placeholders in address registers to iovas */
+	ret = rkvdec2_translate_fd(task);
+	if (ret)
+		goto err_free;
+
+	dev_info(rdev->dev,
+		 "submit: reqs=%u writes=%u fds=%u fmt=%u reg128=0x%08x\n",
+		 cnt, task->w_req_cnt, task->fd_cnt,
+		 task->reg[RKVDEC2_REG_FMT] & 0x3ff, task->reg[128]);
+
+	/* Enqueue to pending — worker calls hw_run */
+	ret = rkvdec2_task_submit(rdev->task_mgr, task);
+	if (ret)
+		goto err_free;
+	return 0;
+
+err_free:
+	rkvdec2_dma_release(task);
+	kfree(task);
+	return ret;
+}
+
+static int rkvdec2_wait_cb(void *priv)
+{
+	struct rkvdec2_dev *rdev = platform_get_drvdata(priv);
+	if (!rdev || !rdev->service)
+		return -ENODEV;
+	return rkvdec2_service_wait(rdev->service);
+}
+
+static void rkvdec2_irq_cb(void *priv)
+{
+	struct rkvdec2_dev *rdev = platform_get_drvdata(priv);
+	if (!rdev || !rdev->task_mgr)
+		return;
+	rkvdec2_task_irq_thread(rdev->task_mgr);
+}
+
+static int rkvdec2_get_clocks(struct rkvdec2_dev *rdev, struct device *dev)
+{
+	rdev->axi   = devm_clk_get(dev, "axi");
+	rdev->ahb   = devm_clk_get(dev, "ahb");
+	rdev->cabac = devm_clk_get(dev, "cabac");
+	rdev->core  = devm_clk_get(dev, "core");
+	rdev->hevc_cabac = devm_clk_get(dev, "hevc_cabac");
+	if (IS_ERR(rdev->axi) || IS_ERR(rdev->ahb) || IS_ERR(rdev->core) ||
+	    IS_ERR(rdev->cabac) || IS_ERR(rdev->hevc_cabac))
+		return dev_err_probe(dev, -ENODEV, "clock missing\n");
+	return 0;
+}
+
+static int rkvdec2_get_resets(struct rkvdec2_dev *rdev, struct device *dev)
+{
+	rdev->rst_axi   = devm_reset_control_get(dev, "axi");
+	rdev->rst_ahb   = devm_reset_control_get(dev, "ahb");
+	rdev->rst_cabac = devm_reset_control_get(dev, "cabac");
+	rdev->rst_core  = devm_reset_control_get(dev, "core");
+	rdev->rst_hevc_cabac = devm_reset_control_get(dev, "hevc_cabac");
+	if (IS_ERR(rdev->rst_axi) || IS_ERR(rdev->rst_ahb))
+		return dev_err_probe(dev, -ENODEV, "reset missing\n");
+	return 0;
+}
+
+static void rkvdec2_reset_deassert(struct rkvdec2_dev *rdev)
+{
+	reset_control_deassert(rdev->rst_axi);
+	reset_control_deassert(rdev->rst_ahb);
+	if (!IS_ERR(rdev->rst_cabac)) reset_control_deassert(rdev->rst_cabac);
+	if (!IS_ERR(rdev->rst_core))  reset_control_deassert(rdev->rst_core);
+	if (!IS_ERR(rdev->rst_hevc_cabac)) reset_control_deassert(rdev->rst_hevc_cabac);
+}
+
+static void rkvdec2_reset_assert(struct rkvdec2_dev *rdev)
+{
+	if (!IS_ERR(rdev->rst_hevc_cabac)) reset_control_assert(rdev->rst_hevc_cabac);
+	if (!IS_ERR(rdev->rst_core))  reset_control_assert(rdev->rst_core);
+	if (!IS_ERR(rdev->rst_cabac)) reset_control_assert(rdev->rst_cabac);
+	reset_control_assert(rdev->rst_ahb);
+	reset_control_assert(rdev->rst_axi);
+}
+
+static int rkvdec2_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct resource *res;
+	struct rkvdec2_dev *rdev;
+	int ret;
+
+	rdev = devm_kzalloc(dev, sizeof(*rdev), GFP_KERNEL);
+	if (!rdev) return -ENOMEM;
+	rdev->dev = dev;
+	platform_set_drvdata(pdev, rdev);
+	of_property_read_u32(dev->of_node, "rockchip,core-id", &rdev->core_id);
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	rdev->regs = devm_ioremap_resource(dev, res);
+	if (IS_ERR(rdev->regs)) return PTR_ERR(rdev->regs);
+
+	ret = rkvdec2_get_clocks(rdev, dev);
+	if (ret) return ret;
+	ret = rkvdec2_get_resets(rdev, dev);
+	if (ret) return ret;
+
+	rdev->irq = platform_get_irq(pdev, 0);
+	if (rdev->irq < 0) return rdev->irq;
+
+	ret = rkvdec2_clk_enable(rdev);
+	if (ret) return ret;
+	rkvdec2_reset_deassert(rdev);
+
+	rkvdec2_hw_init(rdev->regs);
+
+	/* Scratch page (in the IOMMU domain) for address registers that are
+	 * valid-but-null, e.g. scanlist_addr with flat scaling: the hw reads
+	 * them speculatively, so point them here instead of faulting iova 0. */
+	rdev->scratch_cpu = dma_alloc_coherent(dev, SZ_64K, &rdev->scratch_dma,
+					       GFP_KERNEL);
+	if (!rdev->scratch_cpu)
+		return -ENOMEM;
+
+	/* The VDPU381 walks page-table entries upward from IOVA 0,
+	 * reading data from every mapped page.  Map the first 1 GiB
+	 * to a single shared zero page so the walker finds valid
+	 * entries everywhere and completes without faulting. */
+	{
+		struct iommu_domain *dom = iommu_get_domain_for_dev(dev);
+		struct page *zp = alloc_page(GFP_KERNEL | __GFP_ZERO);
+		if (zp && dom) {
+			iommu_map(dom, 0, page_to_phys(zp), SZ_4G,
+				  IOMMU_READ | IOMMU_CACHE, GFP_KERNEL);
+			rdev->zero_page = zp;
+			dev_info(dev, "rkvdec2: mapped 4G zero at iova 0\n");
+		}
+	}
+
+	rdev->service = rkvdec2_service_create(dev, rdev->core_id, rdev->regs);
+	if (IS_ERR(rdev->service)) {
+		ret = PTR_ERR(rdev->service);
+		goto err_service;
+	}
+
+	/* Register with the shared mpp_service (created by rkvenc.ko).
+	 * If rkvenc hasn't probed yet, EPROBE_DEFER triggers reprobe. */
+	{
+		struct rkvenc_service *mpp = rkvenc_service_get();
+		if (IS_ERR(mpp)) {
+			ret = PTR_ERR(mpp);
+			dev_info(dev, "mpp_service deferred (%d)\n", ret);
+			goto err_mpp;
+		}
+		ret = rkvenc_service_register_decoder(mpp, pdev, rdev->core_id,
+						    rkvdec2_submit, rkvdec2_irq_cb);
+		if (ret) {
+			dev_err(dev, "decoder register failed: %d\n", ret);
+			goto err_mpp;
+		}
+		rkvenc_service_set_decoder_wait(mpp, rkvdec2_wait_cb);
+	}
+
+	rdev->task_mgr = rkvdec2_task_create(dev, rdev->service, rdev->regs, rdev->core_id);
+	if (IS_ERR(rdev->task_mgr)) {
+		ret = PTR_ERR(rdev->task_mgr);
+		goto err_task;
+	}
+
+	ret = devm_request_threaded_irq(dev, rdev->irq,
+		rkvdec2_irq, rkvdec2_irq_thread,
+		IRQF_SHARED, dev_name(dev), rdev);
+	if (ret) {
+		dev_err(dev, "irq %d: %d\n", rdev->irq, ret);
+		goto err_irq;
+	}
+
+	pm_runtime_enable(dev);
+	/* Bring-up: hold the RKVDEC0 power domain on. Without this the
+	 * device is runtime-suspended after probe, genpd gates PD_RKVDEC0,
+	 * and the first register write in hw_run hits an unpowered block ->
+	 * AXI stall -> whole-SoC hang. TODO: per-task get/put once stable. */
+	pm_runtime_get_sync(dev);
+	dev_info(dev, "VDPU381 core %u ready\n", rdev->core_id);
+	return 0;
+
+err_irq:   rkvdec2_task_destroy(rdev->task_mgr);
+		/* fall through — register succeeded on this path */
+err_task:
+	{
+		struct rkvenc_service *mpp = rkvenc_service_get();
+		if (!IS_ERR(mpp))
+			rkvenc_service_unregister_decoder(mpp);
+	}
+		/* fall through */
+err_mpp:   rkvdec2_service_destroy(rdev->service);
+err_service:
+	rkvdec2_reset_assert(rdev);
+	rkvdec2_clk_disable(rdev);
+	return ret;
+}
+
+static void rkvdec2_remove(struct platform_device *pdev)
+{
+	struct rkvdec2_dev *rdev = platform_get_drvdata(pdev);
+	pm_runtime_disable(&pdev->dev);
+	{
+		struct rkvenc_service *mpp = rkvenc_service_get();
+		if (!IS_ERR(mpp))
+			rkvenc_service_unregister_decoder(mpp);
+	}
+	rkvdec2_task_destroy(rdev->task_mgr);
+	rkvdec2_service_destroy(rdev->service);
+	rkvdec2_reset_assert(rdev);
+	rkvdec2_clk_disable(rdev);
+}
+
+static const struct of_device_id rkvdec2_match[] = {
+	{ .compatible = "rockchip,rkv-decoder-v2-core" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, rkvdec2_match);
+
+static struct platform_driver rkvdec2_driver = {
+	.probe  = rkvdec2_probe,
+	.remove = rkvdec2_remove,
+	.driver = { .name = "rkvdec2", .of_match_table = of_match_ptr(rkvdec2_match) },
+};
+module_platform_driver(rkvdec2_driver);
+MODULE_DESCRIPTION("Rockchip VDPU381 MPP decoder"); MODULE_LICENSE("GPL");
+MODULE_IMPORT_NS("DMA_BUF");
diff -ruN a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_hw.h b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_hw.h
--- a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_hw.h	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_hw.h	2026-07-18 00:00:00.000000000 +0000
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * VDPU381 decode HAL interface.
+ * Register programming ported incrementally from vendor mpp_rkvdec2.c.
+ * Copyright (C) 2026 fr33m0nk
+ */
+#ifndef _RKVDEC2_HW_H_
+#define _RKVDEC2_HW_H_
+#include <linux/types.h>
+
+enum rkvdec2_codec {
+	RKVDEC2_CODEC_H264 = 0,
+	RKVDEC2_CODEC_HEVC,
+	RKVDEC2_CODEC_VP9,
+	RKVDEC2_CODEC_MAX
+};
+
+/* RK3588 VDPU381 register-file layout - vendor rkvdec_v2_hw_info
+ * (rockchip,rkv-decoder-v2-ccu -> rkvdec_rk3588_data -> rkvdec_v2_hw_info). */
+#define RKVDEC2_REG_NUM         279
+#define RKVDEC2_REG_END         278
+#define RKVDEC2_REG_EN          10
+#define RKVDEC2_REG_FMT         9
+#define RKVDEC2_MAX_WRITE_PART  6
+
+/* IRQ status bits at VDPU_REG_INT_EN (0x380) — shared with task.c */
+#define VDPU_IRQ_READY      BIT(2)
+#define VDPU_IRQ_BUS         BIT(3)
+#define VDPU_IRQ_ERROR       BIT(4)
+#define VDPU_IRQ_TIMEOUT     BIT(5)
+#define VDPU_IRQ_COLMV_ERR   BIT(7)
+#define VDPU_IRQ_ERR_MASK    (VDPU_IRQ_BUS | VDPU_IRQ_ERROR | \
+			      VDPU_IRQ_TIMEOUT | VDPU_IRQ_COLMV_ERR)
+
+/* fd→iova translation structures (vendor MPP common) */
+#define MPP_MAX_REG_TRANS_NUM    80
+
+struct reg_offset_elem {
+	u32 index;
+	u32 offset;
+};
+
+struct reg_offset_info {
+	u32 cnt;
+	struct reg_offset_elem elem[MPP_MAX_REG_TRANS_NUM];
+};
+
+struct rkvdec2_task;
+
+int  rkvdec2_hw_run(void __iomem *regs, struct rkvdec2_task *task);
+void rkvdec2_hw_irq_handler(void __iomem *regs, u32 *status);
+void rkvdec2_hw_power_on(void __iomem *regs);
+void rkvdec2_hw_power_off(void __iomem *regs);
+int  rkvdec2_hw_init(void __iomem *regs);
+void rkvdec2_hw_dump_error(void __iomem *regs);
+const char *rkvdec2_codec_name(enum rkvdec2_codec codec);
+
+/* Translate fd→iova for address registers before hw_run.
+ * Walks the H.264/HEVC/VP9 translate table, extracts fd+offset from
+ * each register value, and replaces with the iova from task->fds[]. */
+int rkvdec2_translate_fd(struct rkvdec2_task *task);
+
+#define RKVDEC2_MAX_WIDTH  7680
+#define RKVDEC2_MAX_HEIGHT 4320
+#endif
diff -ruN a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_hw.c b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_hw.c
--- a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_hw.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_hw.c	2026-07-18 00:00:00.000000000 +0000
@@ -0,0 +1,262 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * VDPU381 decode HAL - replays the userspace-computed register blob
+ * (vendor rkvdec2_run model: cache cfg -> reg blob -> START_EN).
+ * Copyright (C) 2026 fr33m0nk
+ */
+#include <linux/io.h>
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/printk.h>
+#include <linux/kernel.h>
+#include "rkvdec2_hw.h"
+#include "rkvdec2_task.h"
+#include "rkvdec2_iommu.h"
+
+/* VDPU381 register map - from armbian/linux-rockchip rk-6.1-rkr5.1 */
+/* Cache configuration */
+#define VDPU_CACHE0_SIZE       0x51c
+#define VDPU_CACHE1_SIZE       0x55c
+#define VDPU_CACHE2_SIZE       0x59c
+#define VDPU_CLR_CACHE0        0x510
+#define VDPU_CLR_CACHE1        0x550
+#define VDPU_CLR_CACHE2        0x590
+#define VDPU_CACHE_CACHEABLE    BIT(0)
+#define VDPU_CACHE_READ_ALLOC   BIT(1)
+#define VDPU_CACHE_LINE_64      BIT(4)
+
+/* Start / IRQ / Reset */
+#define VDPU_START_EN_BASE     0x28
+#define VDPU_START_EN           BIT(0)
+#define VDPU_REG_INT_EN        0x380   /* irq status/enable (vendor RKVDEC_REG_INT_EN) */
+#define VDPU_POWER_CTRL        0x0010
+#define VDPU_SOFT_RESET         0x0014
+#define VDPU_SOFTRESET_EN       BIT(20)
+
+/* Interrupt status bits at VDPU_REG_INT_EN (vendor rkvdec2) */
+#define VDPU_IRQ            BIT(0)
+#define VDPU_IRQ_RAW        BIT(1)
+#define VDPU_READY_STA      BIT(2)
+#define VDPU_BUS_STA        BIT(3)
+#define VDPU_ERROR_STA      BIT(4)
+#define VDPU_TIMEOUT_STA    BIT(5)
+#define VDPU_COLMV_ERR_STA  BIT(7)
+#define VDPU_ERR_MASK  VDPU_IRQ_ERR_MASK
+
+/* Codec format field in reg[RKVDEC2_REG_FMT] (vendor RKVDEC_GET_FORMAT). */
+#define VDPU_GET_FORMAT(x)  ((x) & 0x3ff)
+
+#define R(reg)    readl(regs + (reg))
+#define W(reg,v)  writel(v, regs + (reg))
+
+int rkvdec2_hw_run(void __iomem *regs, struct rkvdec2_task *task)
+{
+	u32 i, reg_cache;
+
+	/* 1. Soft reset the decode pipeline (vendor rkvdec2_run preamble) */
+	W(VDPU_SOFT_RESET, VDPU_SOFTRESET_EN);
+	udelay(5);
+	W(VDPU_SOFT_RESET, 0);
+	udelay(5);
+
+	/* 3. Cache config - vendor default */
+	reg_cache = VDPU_CACHE_CACHEABLE | VDPU_CACHE_READ_ALLOC | VDPU_CACHE_LINE_64;
+	W(VDPU_CACHE0_SIZE, reg_cache);
+	W(VDPU_CACHE1_SIZE, reg_cache);
+	W(VDPU_CACHE2_SIZE, reg_cache);
+	W(VDPU_CLR_CACHE0, 1);
+	W(VDPU_CLR_CACHE1, 1);
+	W(VDPU_CLR_CACHE2, 1);
+
+	/* 4. Replay register blob captured from userspace (SET_REG_WRITE) */
+	for (i = 0; i < task->w_req_cnt; i++) {
+		u32 off = task->w_reqs[i].offset / sizeof(u32);
+		u32 end = off + task->w_reqs[i].size / sizeof(u32);
+		if (end > RKVDEC2_REG_NUM)
+			end = RKVDEC2_REG_NUM;
+		for (; off < end; off++)
+			W(off * sizeof(u32), task->reg[off]);
+	}
+
+	/* 5. Barrier, then kick the hardware */
+	wmb();
+	pr_info("rkvdec2 hw_run: START reg[%u]=0x%08x w_req=%u\n",
+		RKVDEC2_REG_EN, task->reg[RKVDEC2_REG_EN], task->w_req_cnt);
+	W(VDPU_START_EN_BASE, task->reg[RKVDEC2_REG_EN] | VDPU_START_EN);
+
+	return 0;
+}
+
+/* ---- fd -> iova translation ------------------------------------------ *
+ * Per-codec translate tables (vendor rkvdec_v2_trans, RK3588).  Each entry
+ * is a register index whose value encodes (offset << 10) | fd.            */
+static const u16 trans_tbl_h264d[] = {
+	128, 129, 130, 131, 132, 133, 134, 135, 136, 137, 138, 139, 140, 141, 142,
+	161, 163, 164, 165, 166, 167, 168, 169, 170, 171, 172, 173, 174, 175, 176,
+	177, 178, 179, 180, 181, 182, 183, 184, 185, 186, 187, 188, 189, 190, 191,
+	192, 193, 194, 195, 196, 197, 198, 199
+};
+static const u16 trans_tbl_h265d[] = {
+	128, 129, 130, 131, 132, 133, 134, 135, 136, 137, 138, 139, 140, 141, 142,
+	161, 163, 164, 165, 166, 167, 168, 169, 170, 171, 172, 173, 174, 175, 176,
+	177, 178, 179, 180, 181, 182, 183, 184, 185, 186, 187, 188, 189, 190, 191,
+	192, 193, 194, 195, 196, 197, 198, 199
+};
+static const u16 trans_tbl_vp9d[] = {
+	128, 129, 130, 131, 132, 133, 134, 135, 136, 137, 138, 139, 140, 141, 142,
+	160, 162, 164, 165, 166, 167, 168, 169, 170, 171, 172, 180, 181, 182, 183,
+	184, 185, 186, 187, 188, 189, 190, 191, 192, 193, 194, 195, 196, 197, 198, 199
+};
+static const u16 trans_tbl_avs2d[] = {
+	128, 129, 130, 131, 132, 133, 134, 135, 136, 137, 138, 139, 140, 141, 142,
+	161, 163, 164, 165, 166, 167, 168, 169, 170, 171, 172, 173, 174, 175, 176,
+	177, 178, 179, 180, 181, 182, 183, 184, 185, 186, 187, 188, 189, 190, 191,
+	192, 193, 194, 195, 196, 197, 198, 199
+};
+
+/* Hardware format field values (vendor RKVDEC_FMT_*). */
+enum {
+	RKVDEC_FMT_H265D = 0,
+	RKVDEC_FMT_H264D = 1,
+	RKVDEC_FMT_VP9D  = 2,
+	RKVDEC_FMT_AVS2  = 3,
+};
+
+static const struct { const u16 *tbl; u32 cnt; } rkvdec2_trans[] = {
+	[RKVDEC_FMT_H265D] = { trans_tbl_h265d, ARRAY_SIZE(trans_tbl_h265d) },
+	[RKVDEC_FMT_H264D] = { trans_tbl_h264d, ARRAY_SIZE(trans_tbl_h264d) },
+	[RKVDEC_FMT_VP9D]  = { trans_tbl_vp9d,  ARRAY_SIZE(trans_tbl_vp9d) },
+	[RKVDEC_FMT_AVS2]  = { trans_tbl_avs2d, ARRAY_SIZE(trans_tbl_avs2d) },
+};
+
+/* Resolve one fd-encoded register value to its iova by importing the
+ * dma-buf (import-or-cached in task->fds[]).  fixed_off != 0 overrides the
+ * offset encoded in the register value. */
+static int rkvdec2_xlat_one(struct rkvdec2_task *task, u32 idx, u32 fixed_off)
+{
+	u32 val = task->reg[idx];
+	int fd = val & 0x3ff;
+	u32 offset = fixed_off ?: (val >> 10);
+	dma_addr_t iova;
+
+	if (fd == 0)
+		return 0;   /* unused address slot */
+	iova = rkvdec2_dma_import(task, fd);
+	if (!iova)
+		return -EINVAL;
+	task->reg[idx] = (u32)(iova + offset);
+	return 0;
+}
+
+int rkvdec2_translate_fd(struct rkvdec2_task *task)
+{
+	u32 fmt = VDPU_GET_FORMAT(task->reg[RKVDEC2_REG_FMT]);
+	const u16 *tbl;
+	u32 cnt, i;
+	int ret;
+
+	if (fmt >= ARRAY_SIZE(rkvdec2_trans) || !rkvdec2_trans[fmt].tbl) {
+		pr_err("rkvdec2: unsupported hw format %u\n", fmt);
+		return -EINVAL;
+	}
+	tbl = rkvdec2_trans[fmt].tbl;
+	cnt = rkvdec2_trans[fmt].cnt;
+
+	/* Codec table: indices are hardware-fixed (<= 199); guard anyway. */
+	for (i = 0; i < cnt; i++) {
+		u32 idx = tbl[i];
+		if (idx >= RKVDEC2_REG_NUM)
+			continue;
+		ret = rkvdec2_xlat_one(task, idx, 0);
+		if (ret)
+			return ret;
+	}
+
+	/* SET_REG_ADDR_OFFSET adds a byte offset onto an already fd-translated
+	 * address register (vendor mpp_translate_reg_offset_info). Only apply
+	 * to registers that actually hold a buffer (skip unset 0 bases). */
+	if (task->off_inf.cnt)
+		pr_info("rkvdec2 off_inf cnt=%u\n", task->off_inf.cnt);
+	for (i = 0; i < task->off_inf.cnt; i++) {
+		u32 idx = task->off_inf.elem[i].index;
+		u32 off = task->off_inf.elem[i].offset;
+		if (idx < RKVDEC2_REG_NUM && task->reg[idx])
+			task->reg[idx] += off;
+		pr_info("rkvdec2 off_inf[%u] idx=%u off=0x%x reg=%08x\n",
+			i, idx, off, idx < RKVDEC2_REG_NUM ? task->reg[idx] : 0);
+	}
+
+	/* Address registers (128-199, common_addr + h264d_addr) still
+	 * 0 after translate+offsets → redirect to scratch. Only the
+	 * address window — config regs must NOT receive scratch_iova. */
+	for (i = 128; i < 200; i++)
+		if (task->reg[i] == 0 && task->scratch_iova)
+			task->reg[i] = (u32)task->scratch_iova;
+
+	/* debug: dump all non-zero, non-scratch registers */
+	for (i = 0; i < RKVDEC2_REG_NUM; i++)
+		if (task->reg[i] && task->reg[i] != task->scratch_iova)
+			pr_info("rkvdec2 reg[%u]=%08x\n", i, task->reg[i]);
+
+	return 0;
+}
+
+void rkvdec2_hw_irq_handler(void __iomem *regs, u32 *status)
+{
+	u32 st = R(VDPU_REG_INT_EN);
+
+	if (!(st & VDPU_IRQ_RAW)) {
+		*status = 0;   /* not our interrupt */
+		return;
+	}
+	W(VDPU_REG_INT_EN, 0);   /* ack / clear */
+	*status = st;
+}
+
+void rkvdec2_hw_power_on(void __iomem *regs)
+{ W(VDPU_SOFT_RESET, 0); udelay(10); W(VDPU_POWER_CTRL, 1); }
+
+void rkvdec2_hw_power_off(void __iomem *regs)
+{ W(VDPU_POWER_CTRL, 0); }
+
+int rkvdec2_hw_init(void __iomem *regs)
+{
+	u32 ver;
+	W(VDPU_SOFT_RESET, 1); udelay(10);
+	W(VDPU_SOFT_RESET, 0); udelay(10);
+	W(VDPU_REG_INT_EN, 0);
+	ver = R(0x0000);
+	pr_info("rkvdec2: VDPU381 hw_id %08x\n", ver);
+	return 0;
+}
+
+/* Dump key registers when ERROR_STA fires, to locate the config mismatch.
+ * Vendor mpp_task_dump_hw_reg reads the full window; we narrow to the
+ * performance counter, common config, cache, and address registers. */
+void rkvdec2_hw_dump_error(void __iomem *regs)
+{
+	u32 i;
+#define DREG(r)   pr_info("rkvdec2 err  reg[%03d]=0x%04x: 0x%08x\n", \
+			  (r)/4, (r), readl(regs + (r)))
+	pr_info("rkvdec2: --- ERROR dump (vendor format) ---\n");
+	DREG(0x41c);   /* PERF_WORKING_CNT — cycles before error */
+	DREG(0x380);   /* INT_EN — raw status */
+	DREG(0x028);   /* START_EN */
+	/* Common config (wr span 0x20..0x84): regs 8-32 */
+	for (i = 8; i <= 32; i++) DREG(i * 4);
+	/* Cache config */
+	DREG(0x51c); DREG(0x55c); DREG(0x59c);
+	DREG(0x510); DREG(0x550); DREG(0x590);
+	/* Address register window (128-199) */
+	for (i = 128; i < 200; i++) DREG(i * 4);
+	/* Statistics read-back (256-278) */
+	for (i = 256; i < 279; i++) DREG(i * 4);
+	pr_info("rkvdec2: --- end ERROR dump ---\n");
+#undef DREG
+}
+
+const char *rkvdec2_codec_name(enum rkvdec2_codec c)
+{
+	static const char *n[] = {"H.264","HEVC","VP9"};
+	return (c < RKVDEC2_CODEC_MAX) ? n[c] : "?";
+}
