+++ b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_iommu.h	2026-07-18 00:00:00.000000000 +0000
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* IOMMU DMA allocator for VDPU381.  Copyright (C) 2026 fr33m0nk */
+#ifndef _RKVDEC2_IOMMU_H_
+#define _RKVDEC2_IOMMU_H_
+#include <linux/types.h>
+#include <linux/dma-direction.h>
+#include <linux/device.h>
+
+struct rkvdec2_iommu;
+struct rkvdec2_task;
+
+struct rkvdec2_iommu *rkvdec2_iommu_create(struct device *dev);
+void rkvdec2_iommu_destroy(struct rkvdec2_iommu *io);
+void *rkvdec2_iommu_alloc(struct rkvdec2_iommu *io, size_t size,
+			  dma_addr_t *dma, enum dma_data_direction dir);
+void rkvdec2_iommu_free(struct rkvdec2_iommu *io, size_t size,
+			void *cpu, dma_addr_t dma);
+
+/* Import a dma-buf fd into the decoder's IOMMU domain and return its iova
+ * (cached per-task, so a repeated fd imports once).  Returns 0 on failure. */
+dma_addr_t rkvdec2_dma_import(struct rkvdec2_task *task, int fd);
+/* Release all dma-bufs imported for a task (unmap/detach/put). */
+void rkvdec2_dma_release(struct rkvdec2_task *task);
+
+#endif
diff -ruN a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_iommu.c b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_iommu.c
--- a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_iommu.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_iommu.c	2026-07-18 00:00:00.000000000 +0000
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * IOMMU DMA allocator + dma-buf import for VDPU381 — mirrors rkvenc_iommu.c.
+ * Copyright (C) 2026 fr33m0nk
+ */
+#include <linux/slab.h>
+#include <linux/kernel.h>
+#include <linux/dma-mapping.h>
+#include <linux/dma-buf.h>
+#include <linux/scatterlist.h>
+#include <linux/err.h>
+#include "rkvdec2_iommu.h"
+#include "rkvdec2_task.h"
+
+struct rkvdec2_iommu {
+	struct device *dev;
+	phys_addr_t rcb_base;
+	size_t rcb_size;
+};
+
+struct rkvdec2_iommu *rkvdec2_iommu_create(struct device *dev)
+{
+	struct rkvdec2_iommu *io = kzalloc(sizeof(*io), GFP_KERNEL);
+	if (!io) return ERR_PTR(-ENOMEM);
+	io->dev = dev;
+	/* 40-bit DMA — VDPU381 hardware limit */
+	if (dma_set_mask_and_coherent(dev, DMA_BIT_MASK(40)))
+		dev_warn(dev, "VDPU381: 40-bit DMA mask failed\n");
+	return io;
+}
+
+void rkvdec2_iommu_destroy(struct rkvdec2_iommu *io) { kfree(io); }
+
+void *rkvdec2_iommu_alloc(struct rkvdec2_iommu *io, size_t size,
+			  dma_addr_t *dma, enum dma_data_direction dir)
+{
+	void *cpu;
+	dma_addr_t d;
+	if (!io || !io->dev) return ERR_PTR(-EINVAL);
+	cpu = dma_alloc_coherent(io->dev, size, &d, GFP_KERNEL);
+	if (!cpu) return ERR_PTR(-ENOMEM);
+	if (dma) *dma = d;
+	*(volatile char *)cpu = 0; /* fault in first page */
+	return cpu;
+}
+
+void rkvdec2_iommu_free(struct rkvdec2_iommu *io, size_t size,
+			void *cpu, dma_addr_t dma)
+{
+	if (!io || !io->dev || !cpu) return;
+	dma_free_coherent(io->dev, size, cpu, dma);
+}
+
+/* ---- dma-buf import: fd placeholder -> device iova ------------------- */
+dma_addr_t rkvdec2_dma_import(struct rkvdec2_task *task, int fd)
+{
+	struct dma_buf *dmabuf;
+	struct dma_buf_attachment *attach;
+	struct sg_table *sgt;
+	struct rkvdec2_buf *b;
+	u32 i;
+
+	if (fd <= 0 || !task->dev)
+		return 0;
+
+	/* Already imported this fd for this task? Reuse its iova. */
+	for (i = 0; i < task->fd_cnt; i++)
+		if (task->fds[i].fd == fd)
+			return task->fds[i].iova;
+
+	if (task->fd_cnt >= ARRAY_SIZE(task->fds)) {
+		dev_err(task->dev, "rkvdec2: too many dma-buf fds (>%zu)\n",
+			ARRAY_SIZE(task->fds));
+		return 0;
+	}
+
+	dmabuf = dma_buf_get(fd);
+	if (IS_ERR(dmabuf)) {
+		dev_err(task->dev, "rkvdec2: dma_buf_get(%d) failed (%ld)\n",
+			fd, PTR_ERR(dmabuf));
+		return 0;
+	}
+	attach = dma_buf_attach(dmabuf, task->dev);
+	if (IS_ERR(attach)) {
+		dev_err(task->dev, "rkvdec2: dma_buf_attach(%d) failed (%ld)\n",
+			fd, PTR_ERR(attach));
+		dma_buf_put(dmabuf);
+		return 0;
+	}
+	sgt = dma_buf_map_attachment(attach, DMA_BIDIRECTIONAL);
+	if (IS_ERR(sgt)) {
+		dev_err(task->dev, "rkvdec2: dma_buf_map(%d) failed (%ld)\n",
+			fd, PTR_ERR(sgt));
+		dma_buf_detach(dmabuf, attach);
+		dma_buf_put(dmabuf);
+		return 0;
+	}
+
+	b = &task->fds[task->fd_cnt++];
+	b->fd     = fd;
+	b->dmabuf = dmabuf;
+	b->attach = attach;
+	b->sgt    = sgt;
+	b->iova   = sg_dma_address(sgt->sgl);
+	return b->iova;
+}
+
+void rkvdec2_dma_release(struct rkvdec2_task *task)
+{
+	u32 i;
+
+	for (i = 0; i < task->fd_cnt; i++) {
+		struct rkvdec2_buf *b = &task->fds[i];
+		if (!b->dmabuf)
+			continue;
+		dma_buf_unmap_attachment(b->attach, b->sgt, DMA_BIDIRECTIONAL);
+		dma_buf_detach(b->dmabuf, b->attach);
+		dma_buf_put(b->dmabuf);
+		b->dmabuf = NULL;
+	}
+	task->fd_cnt = 0;
+}
diff -ruN a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_task.h b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_task.h
--- a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_task.h	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_task.h	2026-07-18 00:00:00.000000000 +0000
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Task / job queue manager.  Copyright (C) 2026 fr33m0nk */
+#ifndef _RKVDEC2_TASK_H_
+#define _RKVDEC2_TASK_H_
+#include <linux/device.h>
+#include <linux/types.h>
+#include <linux/list.h>
+#include "rkvdec2_hw.h"
+
+struct rkvdec2_service;
+struct rkvdec2_task_mgr;
+struct dma_buf;
+struct dma_buf_attachment;
+struct sg_table;
+
+/* One imported dma-buf: fd placeholder -> iova, with handles kept alive
+ * for the duration of the decode and released on completion. */
+struct rkvdec2_buf {
+	int fd;
+	struct dma_buf *dmabuf;
+	struct dma_buf_attachment *attach;
+	struct sg_table *sgt;
+	dma_addr_t iova;
+};
+
+/* One decode job: the userspace register blob + queue bookkeeping.
+ * reg[] is filled by SET_REG_WRITE capture in the ioctl dispatch;
+ * w_reqs[] records the written spans, replayed to hardware in hw_run. */
+struct rkvdec2_task {
+	struct list_head node;
+	u32 reg[RKVDEC2_REG_NUM];
+	struct { u32 offset; u32 size; } w_reqs[RKVDEC2_MAX_WRITE_PART];
+	u32 w_req_cnt;
+	void *mpp_task;  /* opaque MPP userspace handle - wired in phase 2 */
+	u32 task_id;
+	int status;      /* 0=pending, 1=running, <0=error */
+
+	/* fd->iova translation (SET_REG_ADDR_OFFSET) */
+	struct reg_offset_info off_inf;
+	/* Device the dma-bufs are imported against (rkvdec2 IOMMU domain). */
+	struct device *dev;
+	/* Imported buffers: fd placeholders resolved in reg[] by translate. */
+	struct rkvdec2_buf fds[16];
+	u32 fd_cnt;
+	dma_addr_t scratch_iova;  /* fallback for valid-but-null addr regs */
+};
+
+struct rkvdec2_task_mgr *rkvdec2_task_create(struct device *dev,
+	struct rkvdec2_service *svc, void __iomem *regs, u32 core_id);
+void rkvdec2_task_destroy(struct rkvdec2_task_mgr *tm);
+
+/* Threaded IRQ bottom-half: dequeues completed jobs, signals the
+ * service, and starts the next pending decode. */
+void rkvdec2_task_irq_thread(struct rkvdec2_task_mgr *tm);
+
+/* Latch IRQ status from the top-half for the threaded bottom-half. */
+void rkvdec2_task_latch_irq(struct rkvdec2_task_mgr *tm, u32 st);
+int  rkvdec2_task_submit(struct rkvdec2_task_mgr *tm, struct rkvdec2_task *task);
+
+#endif
diff -ruN a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_task.c b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_task.c
--- a/drivers/media/platform/rockchip/rkvdec2/rkvdec2_task.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvdec2/rkvdec2_task.c	2026-07-18 00:00:00.000000000 +0000
@@ -0,0 +1,152 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Task / job queue manager for VDPU381 decode.
+ * Dequeues from MPP service, runs on hardware, signals back.
+ * Adapted from rcawston's rkvenc_task.c.
+ * Copyright (C) 2026 fr33m0nk
+ */
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/list.h>
+#include <linux/workqueue.h>
+#include <linux/err.h>
+#include "rkvdec2_task.h"
+#include "rkvdec2_service.h"
+#include "rkvdec2_hw.h"
+#include "rkvdec2_iommu.h"
+#include <linux/iommu.h>
+#include <linux/io.h>
+
+#define MAX_INFLIGHT 4	/* VDPU381 multi-slot decode pipeline */
+
+struct rkvdec2_task_mgr {
+	struct device *dev;
+	struct rkvdec2_service *svc;
+	void __iomem *regs;
+	u32 core_id;
+	spinlock_t lock;
+	struct list_head pending;
+	struct list_head running;
+	struct work_struct work;
+	u32 task_counter;
+	u32 last_irq_status;	/* latched from IRQ top-half for threaded bh */
+};
+
+static void rkvdec2_task_worker(struct work_struct *work)
+{
+	struct rkvdec2_task_mgr *tm = container_of(work, struct rkvdec2_task_mgr, work);
+	struct rkvdec2_task *task;
+	unsigned long flags;
+	int running = 0, ret;
+
+	spin_lock_irqsave(&tm->lock, flags);
+	list_for_each_entry(task, &tm->running, node)
+		running++;
+
+	while (running < MAX_INFLIGHT && !list_empty(&tm->pending)) {
+		task = list_first_entry(&tm->pending, struct rkvdec2_task, node);
+		list_move_tail(&task->node, &tm->running);
+		task->status = 1;
+		running++;
+
+		spin_unlock_irqrestore(&tm->lock, flags);
+		{
+			struct iommu_domain *dom =
+				iommu_get_domain_for_dev(tm->dev);
+			if (dom) {
+				iommu_detach_device(dom, tm->dev);
+				/* Clear DTE on both MMUs so the
+				 * page-table base is invalidated.
+				 * Mainline rk_iommu_disable doesn't
+				 * do this; the BSP version does. */
+				{ void __iomem *m=ioremap(0xfdc38700,0x80);
+				  if(m){writel(0,m+0x00);writel(0,m+0x40);
+				  iounmap(m);} }
+				iommu_attach_device(dom, tm->dev);
+				iommu_flush_iotlb_all(dom);
+			}
+		}
+		ret = rkvdec2_hw_run(tm->regs, task);
+		if (ret) {
+			task->status = ret;
+			dev_err(tm->dev, "decode task %u failed: %d\n", task->task_id, ret);
+		}
+		spin_lock_irqsave(&tm->lock, flags);
+	}
+	spin_unlock_irqrestore(&tm->lock, flags);
+}
+
+void rkvdec2_task_latch_irq(struct rkvdec2_task_mgr *tm, u32 st)
+{
+	tm->last_irq_status = st;
+}
+
+void rkvdec2_task_irq_thread(struct rkvdec2_task_mgr *tm)
+{
+	struct rkvdec2_task *task, *tmp;
+	unsigned long flags;
+
+	/* Latch IRQ status and mark the current running task complete */
+	spin_lock_irqsave(&tm->lock, flags);
+	if (tm->last_irq_status) {
+		u32 st = tm->last_irq_status;
+		tm->last_irq_status = 0;
+		list_for_each_entry(task, &tm->running, node) {
+			if (task->status == 1) {
+				task->status = (st & VDPU_IRQ_ERR_MASK) ? -EIO : 0;
+				break;
+			}
+		}
+	}
+	list_for_each_entry_safe(task, tmp, &tm->running, node) {
+		int result = task->status;
+		if (result == 1) continue;
+
+		dev_info(tm->dev, "task %u complete, status %d\n",
+			 task->task_id, result);
+		list_del(&task->node);
+		spin_unlock_irqrestore(&tm->lock, flags);
+		rkvdec2_service_signal(tm->svc, result >= 0 ? 0 : result);
+		rkvdec2_dma_release(task);
+		kfree(task);
+		spin_lock_irqsave(&tm->lock, flags);
+	}
+	spin_unlock_irqrestore(&tm->lock, flags);
+
+	schedule_work(&tm->work);
+}
+
+struct rkvdec2_task_mgr *rkvdec2_task_create(struct device *dev,
+	struct rkvdec2_service *svc, void __iomem *regs, u32 core_id)
+{
+	struct rkvdec2_task_mgr *tm;
+
+	tm = kzalloc(sizeof(*tm), GFP_KERNEL);
+	if (!tm) return ERR_PTR(-ENOMEM);
+	tm->dev = dev;
+	tm->svc = svc;
+	tm->regs = regs;
+	tm->core_id = core_id;
+	spin_lock_init(&tm->lock);
+	INIT_LIST_HEAD(&tm->pending);
+	INIT_LIST_HEAD(&tm->running);
+	INIT_WORK(&tm->work, rkvdec2_task_worker);
+	return tm;
+}
+
+void rkvdec2_task_destroy(struct rkvdec2_task_mgr *tm)
+{
+	cancel_work_sync(&tm->work);
+	kfree(tm);
+}
+
+int rkvdec2_task_submit(struct rkvdec2_task_mgr *tm, struct rkvdec2_task *task)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&tm->lock, flags);
+	list_add_tail(&task->node, &tm->pending);
+	spin_unlock_irqrestore(&tm->lock, flags);
+	schedule_work(&tm->work);
+	return 0;
+}
